# Utility command for install/local

build esp-idf/esp-tls/CMakeFiles/install/local.util: CUSTOM_COMMAND esp-idf/esp-tls/all
  COMMAND = cmd.exe /C "cd /D D:\vs\esp-idf5.0\CrowPanel_ESP32_5.0\build\esp-idf\esp-tls && C:\Espressif\tools\cmake\3.20.3\bin\cmake.exe -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
  DESC = Installing only the local directory...
  pool = console
  restat = 1

