  OBJECT_DIR = esp-idf\esp-tls\CMakeFiles\__idf_esp-tls.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = esp-idf\esp-tls\libesp-tls.a
