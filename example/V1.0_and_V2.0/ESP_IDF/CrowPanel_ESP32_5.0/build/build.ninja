  COMMAND = cmd.exe /C "cd /D D:\vs\esp-idf5.0\CrowPanel_ESP32_5.0\build\esp-idf\log && C:\Espressif\tools\cmake\3.20.3\bin\cmake.exe --regenerate-during-build -SD:\vs\esp-idf5.0\CrowPanel_ESP32_5.0 -BD:\vs\esp-idf5.0\CrowPanel_ESP32_5.0\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/log/rebuild_cache: phony esp-idf/log/CMakeFiles/rebuild_cache.util


