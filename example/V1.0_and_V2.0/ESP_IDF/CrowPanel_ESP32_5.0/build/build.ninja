  COMMAND = cmd.exe /C "cd /D D:\vs\esp-idf5.0\CrowPanel_ESP32_5.0\build\esp-idf\app_update && C:\Espressif\tools\cmake\3.20.3\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
